generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id                 Int             @id @default(autoincrement())
  email              String          @unique
  phoneNumber        String?         @unique
  password           String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  role               UserRole
  isActive           Boolean         @default(true)
  referralCode       String?         @unique
  referredById       Int?
  instagramId        String?         @unique
  instagramUrl       String?         @unique
  isKycVerified      Boolean         @default(false)
  firstName          String
  hashedRefreshToken String?
  lastName           String
  Campaigns          Campaign[]      @relation("ClientCampaigns")
  Participation      Participation[]
  UserStats          UserStats?
  referredBy         Users?          @relation("Referrals", fields: [referredById], references: [id])
  referrals          Users[]         @relation("Referrals")
  socialAccounts     SocialAccount[]

  @@map("users")
}

model Campaign {
  id                Int             @id @default(autoincrement())
  clientId          Int
  title             String
  description       String
  requirements      String
  requirementItems  String[]        @default([])
  type              CampaignType    @default(CLIP)
  typeConfig        Json?
  status            CampaignStatus  @default(ACTIVE)
  platforms         Platform[]
  startDate         DateTime
  endDate           DateTime
  minimumPostDate   DateTime?
  payRate           Float
  payUnit           String
  budget            Float
  campaignLink      String?
  telegramGroupLink String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  image             String?
  validationRules   Json?
  client            Users           @relation("ClientCampaigns", fields: [clientId], references: [id])
  participations    Participation[]

  @@map("campaigns")
}

model Participation {
  id                Int       @id @default(autoincrement())
  campaignId        Int
  clipperId         Int
  joinedAt          DateTime  @default(now())
  views             Int       @default(0)
  earnings          Float     @default(0.0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  submissionDetails Json?
  submissionStatus  String?   @default("PENDING")
  submissionUrl     String?
  submittedAt       DateTime?
  lastMetricsSync   DateTime?

  reels    Reel[]
  campaign Campaign @relation(fields: [campaignId], references: [id])
  clipper  Users    @relation(fields: [clipperId], references: [id])

  @@map("participations")
}

model Reel {
  id              Int           @id @default(autoincrement())
  url             String
  participationId Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  status          String        @default("PENDING") // PENDING, VERIFIED, REJECTED
  participation   Participation @relation(fields: [participationId], references: [id])

  @@map("reels")
}

model SocialAccount {
  id                    Int       @id @default(autoincrement())
  userId                Int
  platform              Platform
  username              String    @unique
  profileUrl            String?   @unique
  avatarUrl             String?
  instagramUserId       String?   @unique
  accessToken           String?
  accessTokenExpiresAt  DateTime?
  verificationCode      String    @unique
  isVerified            Boolean   @default(false)
  verifiedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user Users @relation(fields: [userId], references: [id])

  @@unique([userId, platform, username])
  @@map("social_accounts")
}

model UserStats {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  totalViews     Int      @default(0)
  totalReels     Int      @default(0)
  totalEarnings  Float    @default(0.0)
  activeReels    Int      @default(0)
  totalCampaigns Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           Users    @relation(fields: [userId], references: [id])

  @@map("user_stats")
}

enum UserRole {
  CLIPPER
  CLIENT
  SUPER_ADMIN
  ADMIN
}

enum CampaignStatus {
  ACTIVE
  INACTIVE
  PAYMENT_PROCESSING
  COMPLETED
  DRAFT
  PAUSED
}

enum CampaignType {
  CLIP
  UGC
  MUSIC_PROMO
  CHALLENGE
  AFFILIATE
}

enum Platform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  TWITTER
  FACEBOOK
}
